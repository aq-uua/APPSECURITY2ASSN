@model WebApplication3.ViewModels.TwoFactorEmailModel
<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Your Farm Fresh Market verification code</title>
    <style>
      body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial; background:#f7f7f5; color:#333; }
      .container { max-width:520px; margin:30px auto; background:white; border-radius:8px; overflow:hidden; box-shadow:0 6px 18px rgba(0,0,0,0.08); }
      .header { background:linear-gradient(90deg,#2f6b3a,#5c8b5a); color:white; padding:20px; }
      .content { padding:24px; }
      .code { font-size:28px; letter-spacing:0.2rem; font-weight:700; background:#f0f4ef; padding:12px 16px; border-radius:8px; text-align:center; }
      .footer { font-size:12px; color:#777; padding:16px; text-align:center; }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h2 style="margin:0">Farm Fresh Market</h2>
      </div>
      <div class="content">
        <h3>Your verification code</h3>
        <p>Use the code below to complete your sign-in.</p>
        <div class="code">@Model.Code</div>
        <p>This code expires in @Model.ExpiresMinutes minutes.</p>
        <p>If you did not attempt to sign in, please secure your account.</p>
      </div>
      <div class="footer">&copy; @DateTime.UtcNow.Year Farm Fresh Market</div>
    </div>
  </body>
</html>
