@page
@model WebApplication3.Pages.ProfileModel
@{
    ViewData["Title"] = "Your Profile";
}

<section class="profile-hero">
    <div class="container">
        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div class="alert alert-success mb-4" role="alert">@Model.StatusMessage</div>
        }
        <div class="profile-hero-card">
            <div class="profile-avatar">
                @if (!string.IsNullOrWhiteSpace(Model.Photo.PhotoUrl))
                {
                    <img src="@Model.Photo.PhotoUrl" alt="Profile photo" />
                }
                else
                {
                    <span>🌿</span>
                }
            </div>
            <div class="profile-hero-content">
                <p class="profile-eyebrow">Your account</p>
                <h1>@Model.Personal.FullName</h1>
                <p class="text-muted">@Model.Email</p>
            </div>
            <div class="profile-hero-actions">
                <a class="btn btn-outline" href="/ChangePassword">Change password</a>
                <a class="btn btn-primary" href="#security">Security settings</a>
            </div>
        </div>
    </div>
</section>

<section class="profile-section">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="profile-card">
                    <div class="profile-card-header">
                        <h2>Personal information</h2>
                        <p class="text-muted">Keep your details up to date for smooth deliveries.</p>
                    </div>
                    <form method="post" asp-page-handler="Personal">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Personal.FullName" class="form-label"></label>
                                <input asp-for="Personal.FullName" class="form-control" />
                                <span asp-validation-for="Personal.FullName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Email</label>
                                <input class="form-control" value="@Model.Email" disabled />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Personal.Gender" class="form-label"></label>
                                <select asp-for="Personal.Gender" class="form-select" asp-items="Html.GetEnumSelectList<WebApplication3.Model.GenderType>()"></select>
                                <span asp-validation-for="Personal.Gender" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Personal.MobileNumber" class="form-label"></label>
                                <input asp-for="Personal.MobileNumber" class="form-control" />
                                <span asp-validation-for="Personal.MobileNumber" class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Personal.AboutMe" class="form-label"></label>
                                <textarea asp-for="Personal.AboutMe" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Personal.AboutMe" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="profile-card-actions">
                            <button class="btn btn-primary" type="submit">Save changes</button>
                        </div>
                    </form>
                </div>

                <div class="profile-card" id="delivery">
                    <div class="profile-card-header">
                        <h2>Delivery details</h2>
                        <p class="text-muted">Securely stored and encrypted at rest.</p>
                    </div>
                    <form method="post" asp-page-handler="Delivery">
                        <div class="mb-3">
                            <label asp-for="Delivery.DeliveryAddress" class="form-label"></label>
                            <textarea asp-for="Delivery.DeliveryAddress" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Delivery.DeliveryAddress" class="text-danger"></span>
                        </div>
                        <div class="profile-card-actions">
                            <button class="btn btn-primary" type="submit">Update address</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="profile-card" id="payment">
                    <div class="profile-card-header">
                        <h2>Payment</h2>
                        <p class="text-muted">Update the card for membership charges.</p>
                    </div>
                    <form method="post" asp-page-handler="Payment">
                        <div class="mb-2">
                            <span class="profile-label">Saved card</span>
                            <div class="profile-muted">@Model.Payment.MaskedCard</div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Payment.CreditCard" class="form-label"></label>
                            <input asp-for="Payment.CreditCard" class="form-control" placeholder="Enter new card number" />
                            <span asp-validation-for="Payment.CreditCard" class="text-danger"></span>
                        </div>
                        <div class="profile-card-actions">
                            <button class="btn btn-primary" type="submit">Save card</button>
                        </div>
                    </form>
                </div>

                <div class="profile-card" id="photo">
                    <div class="profile-card-header">
                        <h2>Profile photo</h2>
                        <p class="text-muted">JPG only, max 5MB.</p>
                    </div>
                    <form method="post" asp-page-handler="Photo" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label asp-for="Photo.Photo" class="form-label"></label>
                            <input asp-for="Photo.Photo" class="form-control" type="file" />
                            <span asp-validation-for="Photo.Photo" class="text-danger"></span>
                        </div>
                        <div class="profile-card-actions">
                            <button class="btn btn-primary" type="submit">Upload photo</button>
                        </div>
                    </form>
                </div>

                <div class="profile-card" id="security">
                    <div class="profile-card-header">
                        <h2>Security</h2>
                        <p class="text-muted">Manage two-factor authentication and recovery codes.</p>
                    </div>
                    <div class="profile-security-status">
                        <span class="profile-label">Two-factor authentication</span>
                        <span class="badge @(Model.IsTwoFactorEnabled ? "bg-success" : "bg-warning")">
                            @(Model.IsTwoFactorEnabled ? "Enabled" : "Disabled")
                        </span>
                    </div>
                    <form method="post" class="mb-3">
                        @if (Model.IsTwoFactorEnabled)
                        {
                            <button class="btn btn-outline" type="submit" asp-page-handler="Disable2fa">Disable 2FA</button>
                        }
                        else
                        {
                            <button class="btn btn-primary" type="submit" asp-page-handler="Enable2fa">Enable 2FA</button>
                        }
                    </form>

                    <div class="profile-security-row">
                        <span class="profile-label">Password</span>
                        <a class="btn btn-outline" href="/ChangePassword">Change password</a>
                    </div>

                    @if (Model.IsTwoFactorEnabled)
                    {
                        <form method="post">
                            <button class="btn btn-secondary" type="submit" asp-page-handler="GenerateRecoveryCodes">Generate recovery codes</button>
                        </form>

                        @if (Model.RecoveryCodes?.Length > 0)
                        {
                            <div class="mt-4">
                                <h5>Recovery codes</h5>
                                <p class="text-muted">Store these in a safe place. Each code can be used once.</p>
                                <ul class="list-group">
                                    @foreach (var code in Model.RecoveryCodes)
                                    {
                                        <li class="list-group-item">@code</li>
                                    }
                                </ul>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
