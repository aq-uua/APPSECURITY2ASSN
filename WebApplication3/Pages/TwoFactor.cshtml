@page
@model WebApplication3.Pages.TwoFactorModel
@{
    ViewData["Title"] = "Two-Factor";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-lg">
                <div class="card-body p-4 p-md-5">
                    <h2 class="mb-3">Two-factor authentication</h2>
                    <p class="text-muted">Add an extra layer of security to your account.</p>

                    <div class="alert @(Model.IsEnabled ? "alert-success" : "alert-warning")" role="alert">
                        @if (Model.IsEnabled)
                        {
                            <span>Two-factor authentication is enabled.</span>
                        }
                        else
                        {
                            <span>Two-factor authentication is not enabled.</span>
                        }
                    </div>

                    <form method="post">
                        @if (!Model.IsEnabled)
                        {
                            <button class="btn btn-primary" type="submit" asp-page-handler="Enable">Enable 2FA</button>
                        }
                        else
                        {
                            <button class="btn btn-outline" type="submit" asp-page-handler="Disable">Disable 2FA</button>
                        }
                    </form>

                    @if (Model.IsEnabled)
                    {
                        <hr class="my-4" />
                        <form method="post">
                            <button class="btn btn-secondary" type="submit" asp-page-handler="GenerateRecoveryCodes">Generate recovery codes</button>
                        </form>

                        @if (Model.RecoveryCodes?.Length > 0)
                        {
                            <div class="mt-4">
                                <h5>Recovery codes</h5>
                                <p class="text-muted">Store these in a safe place. Each code can be used once.</p>
                                <ul class="list-group">
                                    @foreach (var code in Model.RecoveryCodes)
                                    {
                                        <li class="list-group-item">@code</li>
                                    }
                                </ul>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
