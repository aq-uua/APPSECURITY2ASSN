@page
@model WebApplication3.Pages.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-lg">
                <div class="card-body p-4 p-md-5">
                    <h2 class="mb-3">Reset your password</h2>
                    <p class="text-muted">Enter your email to receive a reset link.</p>

                    <form method="post" id="forgotPasswordForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label"></label>
                            <input asp-for="Input.Email" class="form-control" />
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">Send reset link</button>
                        </div>

                        <input type="hidden" asp-for="Input.RecaptchaToken" id="forgotRecaptchaToken" />
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.RecaptchaEnabled)
    {
        <script src="https://www.google.com/recaptcha/api.js?render=@Model.RecaptchaSiteKey"></script>
        <script>
            (function () {
                const form = document.getElementById('forgotPasswordForm');
                if (!form || typeof grecaptcha === 'undefined') {
                    return;
                }

                form.addEventListener('submit', function (event) {
                    event.preventDefault();
                    grecaptcha.ready(function () {
                        grecaptcha.execute('@Model.RecaptchaSiteKey', { action: 'forgot_password' }).then(function (token) {
                            const field = document.getElementById('forgotRecaptchaToken');
                            if (field) {
                                field.value = token;
                            }
                            form.submit();
                        });
                    });
                });
            })();
        </script>
    }
}
