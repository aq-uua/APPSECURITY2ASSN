@page
@model WebApplication3.Pages.ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Password reset";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 text-center">
            <h2 class="mb-3">Your password is updated</h2>
            <p class="text-muted">You can now sign in with your new password.</p>
            <a class="btn btn-primary" href="/Login">Return to login</a>
        </div>
    </div>
</div>
