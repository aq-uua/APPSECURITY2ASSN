@page
@model WebApplication3.Pages.StatusCodeModel
@{
    ViewData["Title"] = "Request Status";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 text-center">
            <h1 class="mb-3">@Model.Title</h1>
            <p class="text-muted mb-4">@Model.Message</p>
            <div class="d-flex justify-content-center gap-3">
                <a class="btn btn-primary" href="/">Return to Home</a>
                <a class="btn btn-outline" href="/Login">Sign In</a>
            </div>
        </div>
    </div>
</div>
