@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 text-center">
            <h1 class="mb-3">Something went wrong</h1>
            <p class="text-muted mb-4">We hit a snag while processing your request. Please try again in a moment or head back to the marketplace.</p>
            <div class="d-flex justify-content-center gap-3">
                <a class="btn btn-primary" href="/">Return to Home</a>
                <a class="btn btn-outline" href="/Login">Sign In</a>
            </div>
            @if (Model.ShowRequestId)
            {
                <div class="mt-4 text-muted">
                    <small>Request ID: <code>@Model.RequestId</code></small>
                </div>
            }
        </div>
    </div>
</div>
