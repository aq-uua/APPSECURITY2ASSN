@page
@model WebApplication3.Pages.ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Check your email";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 text-center">
            <h2 class="mb-3">Check your email</h2>
            <p class="text-muted">If an account exists for that email, we sent a reset link. Please check your inbox.</p>
            <a class="btn btn-primary" href="/Login">Return to login</a>
        </div>
    </div>
</div>
